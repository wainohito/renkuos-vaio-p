+/* DPMS. The pipe and the panel are left alone: powering them down and up
+   needs the panel power sequence, and this driver never sets a mode. Off,
+   stand-by and suspend switch the display plane off, so the pipe sends
+   black, and the panel backlight off, which is where the power goes on a
+   netbook. Without this the screen saver's "turn off the screen" did
+   nothing at all with this driver: vesa, which it replaces, did both. */
+static uint32 sDPMSMode = B_DPMS_ON;
+
+
+static uint32
+poulsbo_dpms_capabilities(void)
+{
+	return B_DPMS_ON | B_DPMS_STAND_BY | B_DPMS_SUSPEND | B_DPMS_OFF;
+}
+
+
+static uint32
+poulsbo_dpms_mode(void)
+{
+	return sDPMSMode;
+}
+
+
+/* The cursor plane stays on screen without the display plane, so it is
+   switched off with it and put back as it was. */
+static uint32 sCursorControlBeforeDPMS;
+static bool sCursorOffForDPMS = false;
+
+
+static void
+set_cursor_plane_for_dpms(bool on)
+{
+	if (!on && !sCursorOffForDPMS) {
+		sCursorControlBeforeDPMS = read32(PSB_CURBCNTR);
+		write32(PSB_CURBCNTR, PSB_CURSOR_MODE_DISABLE);
+		write32(PSB_CURBBASE, read32(PSB_CURBBASE));
+		sCursorOffForDPMS = true;
+	} else if (on && sCursorOffForDPMS) {
+		write32(PSB_CURBCNTR, sCursorControlBeforeDPMS);
+		write32(PSB_CURBBASE, read32(PSB_CURBBASE));
+		sCursorOffForDPMS = false;
+	}
+}
+
+
+static void
+set_display_plane(bool on)
+{
+	uint32 control = read32(PSB_DSPBCNTR);
+	uint32 wanted = on ? control | PSB_PLANE_ENABLE
+		: control & ~PSB_PLANE_ENABLE;
+	if (wanted == control)
+		return;
+	write32(PSB_DSPBCNTR, wanted);
+	/* The plane registers take effect when the base is written; write back
+	   what is there, as Linux gma500 does. */
+	write32(PSB_DSPBLINOFF, read32(PSB_DSPBLINOFF));
+	write32(PSB_DSPBSURF, read32(PSB_DSPBSURF));
+	(void)read32(PSB_DSPBSURF);
+}
+
+
+static status_t
+poulsbo_set_dpms_mode(uint32 mode)
+{
+	const bool on = mode == B_DPMS_ON;
+	uint32 backlight = on ? 1 : 0;
+
+	if ((mode & poulsbo_dpms_capabilities()) == 0)
+		return B_BAD_VALUE;
+
+	if (on) {
+		set_display_plane(true);
+		set_cursor_plane_for_dpms(true);
+	}
+	/* Best effort: on a machine whose backlight nobody publishes this fails
+	   and only the plane goes dark. */
+	ioctl(sDeviceFD, POULSBO_SET_BACKLIGHT, &backlight, sizeof(backlight));
+	if (!on) {
+		set_cursor_plane_for_dpms(false);
+		set_display_plane(false);
+	}
+
+	sDPMSMode = on ? B_DPMS_ON : mode;
+	return B_OK;
+}
