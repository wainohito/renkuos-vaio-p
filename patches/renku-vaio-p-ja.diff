+static void
+poulsbo_wait_engine_idle(void)
+{
+	int spin;
+	for (spin = 0; spin < 1000000; spin++) {
+		if ((sgx_read(PSB_CR_2D_BLIT_STATUS) & PSB_C2B_STATUS_BUSY) == 0)
+			return;
+	}
+}
