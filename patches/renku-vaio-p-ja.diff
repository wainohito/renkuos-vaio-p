@@ -53,6 +53,24 @@ timespec_to_bigtime(const timespec& spec, bigtime_t& _time)
 }
 
 
+/*!	Like timespec_to_bigtime(), for a point in time rather than a duration
+	(an absolute timeout, a clock setting, a file time): on 32-bit x86 the
+	seconds are read as unsigned (see __haiku_time_to_int64() in <time.h>), so
+	a time after January 2038 is not refused as negative.
+*/
+static inline bool
+absolute_timespec_to_bigtime(const timespec& spec, bigtime_t& _time)
+{
+	int64 seconds = __haiku_time_to_int64(spec.tv_sec);
+	if (seconds < 0 || spec.tv_nsec < 0 || spec.tv_nsec >= 1000000000)
+		return false;
+
+	_time = seconds * 1000000 + (spec.tv_nsec + 999) / 1000;
+
+	return true;
+}
