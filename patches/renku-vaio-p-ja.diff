+static status_t
+poulsbo_sync_to_token(sync_token* token)
+{
+	/* 하드웨어가 주는 것은 "완료한 블릿 수"와 busy 비트뿐이라, 토큰별로
+	   기다리는 대신 엔진이 놀 때까지 기다린다. 보수적이지만 틀리지 않는다. */
+	poulsbo_wait_engine_idle();
+	return B_OK;
+}
