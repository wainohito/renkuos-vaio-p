+
+// Raw PCI configuration mechanism 1. The loader has no PCI module; these
+// twenty lines are the whole requirement.
+
+static uint32
+pci_cfg_read(uint8 bus, uint8 device, uint8 function, uint8 offset, int size)
+{
+	out32(0x80000000 | (bus << 16) | (device << 11) | (function << 8)
+		| (offset & 0xfc), 0xcf8);
+	uint32 value = in32(0xcfc);
+	value >>= (offset & 3) * 8;
+	if (size == 1)
+		return value & 0xff;
+	if (size == 2)
+		return value & 0xffff;
+	return value;
+}
+
+
+static void
+pci_cfg_write(uint8 bus, uint8 device, uint8 function, uint8 offset, int size,
+	uint32 value)
+{
+	out32(0x80000000 | (bus << 16) | (device << 11) | (function << 8)
+		| (offset & 0xfc), 0xcf8);
+	if (size == 1)
+		out8(value, 0xcfc + (offset & 3));
+	else if (size == 2)
+		out16(value, 0xcfc + (offset & 3));
+	else
+		out32(value, 0xcfc);
+}
+
+
+/*!	Takes the Poulsbo/SCH EHCI controller away from the BIOS before the AP is
+	woken, replicating the kernel's intel_fixup_ehci_bar() (pci_fixup.cpp) --
+	which runs at kernel PCI scan time, far too late for this purpose.
+
+	Why here: on the VAIO P the AP intermittently cannot be started, decided
+	per boot, and the boots that fail are exactly the boots where a ~200 ms
+	stall (an SMI storm; this thread simply stops executing) lands in the
+	INIT-to-SIPI window -- measured via the sliced spin in
+	smp_send_init_sipi(). This BIOS never acknowledges the EHCI legacy
+	handoff, so its USB legacy emulation is still armed and generating SMIs
+	throughout the loader's early wake. An SMI takes *both* logical processors
+	into SMM; an INIT/SIPI colliding with that is handled by firmware whose
+	idea of the sibling's state is its own business. Killing the BIOS's EHCI
+	claim and every one of its SMI enables before the first INIT removes that
+	collision at the source.
+
+	Gated to the SCH EHCI (8086:8117) found on bus 0, so it is a no-op
+	everywhere else. The SCH's UHCI companions (0x8114-0x8116) are left
+	strictly alone: they do not implement the standard USBLEGSUP register and
+	writing it corrupts their transfer engine (see the UHCI headline fix).
+*/
+static void
+smp_early_usb_handoff(void)
+{
+	// Never while the BIOS's own USB machinery still has work to do: booting
+	// from a USB stick, the loader reads the kernel via INT 13h *after* this
+	// point, and killing the BIOS's EHCI SMIs first broke exactly that on
+	// real hardware -- the very next partition scan read a bytes_per_sector
+	// of 0 and BIOSDrive::ReadAt() died on a divide error. Only an explicit
+	// EDD "ATA" answer for the boot drive makes this safe; anything else
+	// (USB, no EDD 3.0, no answer) skips.
+	if (!platform_boot_drive_is_ata()) {
+		dprintf("smp: early usb handoff skipped: boot drive is not ATA, the "
+			"BIOS's USB machinery may be load-bearing for INT 13h\n");
+		return;
+	}
+
+	for (uint8 device = 0; device < 32; device++) {
+		for (uint8 function = 0; function < 8; function++) {
+			uint32 id = pci_cfg_read(0, device, function, 0, 4);
+			if (id != 0x81178086)
+				continue;
+
+			uint32 bar0 = pci_cfg_read(0, device, function, 0x10, 4);
+			uint16 pciCommand = pci_cfg_read(0, device, function, 0x04, 2);
+			pci_cfg_write(0, device, function, 0x04, 2,
+				pciCommand | 0x02 /* memory decode */);
+
+			// EECP lives in MMIO HCCPARAMS bits 15:8; the capability
+			// registers themselves are in config space.
+			uint8 eecp = 0;
+			if ((bar0 & ~0xfffUL) != 0) {
+				addr_t regs = mmu_map_physical_memory(bar0 & ~0xfffUL,
+					B_PAGE_SIZE, kDefaultPageFlags);
+				if (regs != 0) {
+					uint32 hccparams = *(volatile uint32 *)(regs + 8);
+					eecp = (hccparams >> 8) & 0xff;
+				}
+			}
+			if (eecp < 0x40)
+				eecp = 0x68;	// SCH datasheet's fixed offset
+
+			uint32 legacySupport = pci_cfg_read(0, device, function, eecp, 4);
+			if ((legacySupport & 0xff) != 0x01) {
+				dprintf("smp: early usb handoff: no legacy capability at "
+					"%#02x (%#08" B_PRIx32 "), skipping\n", eecp,
+					legacySupport);
+				pci_cfg_write(0, device, function, 0x04, 2, pciCommand);
+				return;
+			}
+
+			bool wasBiosOwned = (legacySupport & (1 << 16)) != 0;
+			if (wasBiosOwned) {
+				// Ask politely first, but only briefly -- this BIOS has
+				// never once acknowledged, so the wait is a formality.
+				pci_cfg_write(0, device, function, eecp + 3, 1, 1);
+				for (int32 i = 0; i < 10; i++) {
+					legacySupport
+						= pci_cfg_read(0, device, function, eecp, 4);
+					if ((legacySupport & (1 << 16)) == 0)
+						break;
+					smp_delay_us(5000);
+				}
+			}
+
+			// Force the BIOS semaphore off and disable/clear every SMI
+			// source regardless.
+			pci_cfg_write(0, device, function, eecp + 2, 1, 0);
+			pci_cfg_write(0, device, function, eecp + 4, 4, 0);
+			pci_cfg_write(0, device, function, 0x04, 2, pciCommand);
+
+			dprintf("smp: early usb handoff: EHCI at 0:%u:%u, was %s, SMI "
+				"enables cleared %" B_PRIu32 " ms before the wake\n",
+				device, function, wasBiosOwned
+					? ((legacySupport & (1 << 16)) != 0
+						? "BIOS-owned (forced off)" : "BIOS-owned (released)")
+					: "already unowned",
+				(uint32)(smp_early_now_us() / 1000));
+			return;
+		}
+	}
+}
+
+
+
+static uint16 sSmiEnPort = 0;
+static uint32 sSavedSmiEn = 0;
+
+
+/*!	Stops the chipset generating SMIs for the length of the wake.
+
+	The EHCI handoff above removes one SMI source. It is not the only one: the
+	chipset can also raise SMIs for power management, GPEs and the TCO timer,
+	and every SMI takes *both* logical processors of this single-core-plus-HT
+	part into SMM. While the firmware is servicing one, the sibling cannot be
+	starting, which is exactly what the failed boots look like from here -- the
+	AP never executes its first instruction and the APIC reports no error.
+
+	GBL_SMI_EN (bit 0 of SMI_EN, at PMBASE+0x30 on this chipset, PMBASE being
+	the I/O BAR at LPC config offset 0x40) gates all of them. It is cleared
+	only across the INIT/SIPI attempts and put back immediately afterwards:
+	leaving the firmware without SMIs for the whole session would cost it
+	thermal and battery handling.
+*/
+static void
+smp_mask_global_smi(void)
+{
+	// Find the LPC bridge by its ID rather than assuming a slot: this chipset
+	// does not put it where the ICH convention would.
+	uint8 lpcBus = 0, lpcDevice = 0xff, lpcFunction = 0;
+	for (uint8 device = 0; device < 32 && lpcDevice == 0xff; device++) {
+		for (uint8 function = 0; function < 8; function++) {
+			if (pci_cfg_read(0, device, function, 0x00, 4) == 0x81198086) {
+				lpcDevice = device;
+				lpcFunction = function;
+				break;
+			}
+		}
+	}
+	if (lpcDevice == 0xff) {
+		dprintf("smp: no SCH LPC bridge found; leaving SMI sources alone\n");
+		return;
+	}
+
+	// Report the base-address candidates instead of guessing which offset
+	// holds the power-management block on this part.
+	dprintf("smp: LPC 8086:8119 at %u:%u:%u, cfg 0x40..0x4c = %#" B_PRIx32
+		" %#" B_PRIx32 " %#" B_PRIx32 " %#" B_PRIx32 "\n",
+		lpcBus, lpcDevice, lpcFunction,
+		pci_cfg_read(lpcBus, lpcDevice, lpcFunction, 0x40, 4),
+		pci_cfg_read(lpcBus, lpcDevice, lpcFunction, 0x44, 4),
+		pci_cfg_read(lpcBus, lpcDevice, lpcFunction, 0x48, 4),
+		pci_cfg_read(lpcBus, lpcDevice, lpcFunction, 0x4c, 4));
+
+	uint32 pmbase = pci_cfg_read(lpcBus, lpcDevice, lpcFunction, 0x40, 4);
+	if ((pmbase & 1) == 0) {
+		dprintf("smp: LPC cfg 0x40 is not an I/O base; not touching SMI_EN\n");
+		return;
+	}
+	uint16 base = (uint16)(pmbase & 0xff80);
+	if (base == 0)
+		return;
+
+	sSmiEnPort = base + 0x30;
+	sSavedSmiEn = in32(sSmiEnPort);
+	dprintf("smp: chipset SMI_EN at %#x reads %#" B_PRIx32 "%s\n",
+		sSmiEnPort, sSavedSmiEn,
+		(sSavedSmiEn & 1) != 0
+			? " -- GBL_SMI_EN set, clearing it for the wake"
+			: " -- GBL_SMI_EN already clear");
+
+	if ((sSavedSmiEn & 1) == 0) {
+		sSmiEnPort = 0;
+		return;
+	}
+	out32(sSavedSmiEn & ~(uint32)1, sSmiEnPort);
+}
+
+
+static void
+smp_restore_global_smi(void)
+{
+	if (sSmiEnPort == 0)
+		return;
+	out32(sSavedSmiEn, sSmiEnPort);
+	dprintf("smp: chipset SMI_EN restored to %#" B_PRIx32 "\n", sSavedSmiEn);
+	sSmiEnPort = 0;
+}
+
+#endif	// !_PXE_ENV
+
+
+/*!	Wakes the application processors as early as possible and parks them in the
+	trampoline, waiting for the page directory the BSP will publish later.
+
+	On the Sony VAIO P the window in which an AP can be started at all is only
+	a few seconds wide from power-on: measured on hardware, inserting a one
+	second delay before the SIPI still works while five seconds does not, and
+	after that the AP stops responding to INIT and SIPI entirely -- no error,
+	no execution, ten retries make no difference. Normal bring-up happens after
+	the kernel, its add-ons and (with load_symbols, which Haiku enables by
+	default) their symbols have all been read off the disk, which on this
+	machine lands well outside that window and silently costs the second CPU.
+
+	Waking them here instead only needs the gdt, whose contents are static, so
+	it can run long before the kernel exists. The AP reaches 32-bit protected
+	mode and then spins on the page directory slot; smp_boot_other_cpus() fills
+	that in later exactly as before, and the AP carries on. If this did not
+	take, that function still performs the full INIT/SIPI sequence itself, so
+	nothing depends on it having worked.
+*/
+// Writes a string straight to the screen through the BIOS teletype call.
+// console_init() deliberately runs *after* smp_wake_other_cpus_early() -- the
+// video mode switch is kept off the critical path -- so there is no console
+// here and printf() would go nowhere. INT 10h/0Eh does not touch the video
+// mode, which makes it the only way to tell someone watching the screen that
+// the resets below are on purpose. Without this the reroll is indistinguishable
+// from a boot loop, and it has been mistaken for one.
+static void
+reroll_screen_print(const char* string)
+{
+	for (const char* c = string; *c != '\0'; c++) {
+		struct bios_regs regs;
+		regs.eax = 0x0e00 | (uint8)*c;
+		regs.ebx = 0x0007;
+		call_bios(0x10, &regs);
+	}
+}
+
+
+// The deliberate-reboot reroll is only ever correct on the machine it was
+// characterised on, and it is actively harmful elsewhere.
+bool
+smp_early_wake_supported(void)
+{
+	cpuid_info info;
+	if (get_current_cpuid(&info, 1, 0) != B_OK)
+		return false;
+
+	// Under a hypervisor there is no firmware state to re-roll, and the virtual
+	// RTC is cleared along with the machine, so the counter never reaches its
+	// maximum and the reroll becomes an endless reboot loop. Measured: QEMU
+	// rebooted forever until this was gated.
+	if ((info.regs.ecx & (1 << 31)) != 0)
+		return false;
+
+	uint32 family = info.eax_1.family;
+	if (family == 0xf)
+		family += info.eax_1.extended_family;
+	uint32 model = info.eax_1.model;
+	if (family == 6 || family == 0xf)
+		model += info.eax_1.extended_model << 4;
+
+	// Family 6, model 0x1c: the Atom Silverthorne/Diamondville this whole
+	// mechanism was measured against. Anything else boots straight through.
+	return family == 6 && model == 0x1c;
+}
